# Shared secret; must equal AI_SERVICE_TOKEN in server/.env (min 16 chars).
AI_SERVICE_TOKEN=change-me-to-a-long-random-value
# Detector preset: daniels-yolo26 (default, MIT) | keremberke-yolov8n-seg (masks, licence unstated)
DETECTOR_PRESET=daniels-yolo26
# Optional explicit override of the preset (replace the checkpoint without code changes)
# HF_REPO_ID=
# HF_REVISION=          # use a 40-character commit hash
# HF_CHECKPOINT=
HF_OFFLINE=false
DEVICE=cpu              # cpu | cuda | cuda:0 | auto
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.50
INFERENCE_IMAGE_SIZE=640
INFERENCE_TIMEOUT_S=60
DEPTH_ENABLED=true
DEPTH_REPO_ID=depth-anything/Depth-Anything-V2-Small-hf
DEPTH_REVISION=5426e4f0f36572d16453bbda7a8389317b1bef99
VIDEO_MAX_DURATION_S=600
VIDEO_SAMPLE_FPS=5
VIDEO_WORKERS=1
# STORAGE_DIR=../storage        # must be the same directory the Express server uses
# MODEL_CACHE_DIR=../model-cache
