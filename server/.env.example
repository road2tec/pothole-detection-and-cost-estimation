# Copy to server/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/pothole_intelligence

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (HTTPS only cookies)
COOKIE_SECURE=false

AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret; must equal AI_SERVICE_TOKEN in ai-service/.env (min 16 chars)
AI_SERVICE_TOKEN=
AI_REQUEST_TIMEOUT_MS=120000

# Shared file store used by the API and the AI service (defaults to <repo>/storage)
# STORAGE_DIR=../storage
# Hard upper limits; administrators can set lower limits in Configuration
MAX_IMAGE_MB=15
MAX_VIDEO_MB=500
MAX_FILES_PER_UPLOAD=20

WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1500

# Optional e-mail (password reset). Without it, users are told to contact an administrator.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Power BI Service integration (see powerbi/README.md). Leave empty for local development.
POWERBI_SECURE_EMBED_URL=
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
POWERBI_REPORT_ID=
# Public URL of this API, shown to Power BI users when behind a proxy
# API_PUBLIC_URL=https://roads.example.gov.in

LOG_LEVEL=info
